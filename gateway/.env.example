# Express API Gateway server port
PORT=3000

# Authorized Sender Number (Format: 628123456789 without '+' or '@s.whatsapp.net')
# Only messages from this number will trigger the agent and commands.
AUTHORIZED_NUMBER=628123456789

# Google Gemini API Key from Google AI Studio
GEMINI_API_KEY=your_gemini_api_key_here

# Local n8n Webhook URL (Make sure the path matches your n8n workflow configuration)
N8N_WEBHOOK_URL=http://localhost:5678/webhook/whatsapp

# Absolute path to the default workspace directory on your machine
ACTIVE_WORKSPACE=C:\path\to\your\workspace-default

# Default Gemini Model Identifier (e.g., gemini-3.5-flash, gemini-2.5-flash, gemini-flash-latest)
ACTIVE_MODEL=gemini-3.5-flash

# API Security Key used for securing API requests between n8n, Gateway, and CLI
API_KEY=your_secure_custom_api_key_here
